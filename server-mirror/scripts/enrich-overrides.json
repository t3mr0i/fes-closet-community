  "creators": {
    "3ef85ed1-54c8-4341-b843-c3932d95d405": {
      "studio": "Fashion Entertainments",
      "country": "Japan",
      "city": "Tokyo",
      "genre": "product-design",
      "discipline": "E-paper wearables",
      "intro": "Fashion Entertainments is Sony's in-house startup behind the FES Watch U. They use electronic paper as a fabric so a single watch can carry endless face and strap designs. The first FES Watch U launched on Sony's First Flight crowdfunding platform in 2017, co-designed with Tokyo studio TAKT PROJECT.",
      "url": "https://fashion-entertainments.com/"
    },
    "c1127d20-307a-4017-be88-a34859f56e81": {
      "studio": "iLovedust",
      "country": "United Kingdom",
      "city": "Portsmouth",
      "genre": "graphic-design",
      "discipline": "Graphic design and illustration",
      "intro": "iLovedust is a UK design crüe working under the motto 'Seduction vs. Function' — graphic design, illustration and art direction with a punk edge. Their clients include Nike, Levi's and the New York Times.",
      "url": "https://www.ilovedust.com/"
    },
    "78aa96fe-98d9-43d0-8188-26ca4b8d4341": {
      "studio": "B&A",
      "country": "United States",
      "city": "New York",
      "genre": "illustration",
      "discipline": "Artist representation across photo, illustration, animation, CGI",
      "intro": "B&A is an international artist representation agency with offices in New York, London, Berlin and Los Angeles. Their roster spans photographers, illustrators, animators, CGI studios and mural artists working for global brands.",
      "url": "https://www.ba-reps.com/"
    },
    "9adde805-1d79-460b-8d46-0fc876af88a1": {
      "studio": "HI(NY)",
      "country": "United States",
      "city": "New York / Kyoto",
      "genre": "graphic-design",
      "discipline": "Branding and design direction",
      "intro": "HI(NY) is a boutique design studio founded by Hitomi Watanabe Deluca and Iku Oyamada, with offices in New York and Kyoto. Their work focuses on branding and identity for clients including Coca-Cola, MTV, the United Nations and Isetan; multiple ONE SHOW and GDUSA awards.",
      "url": "https://www.hinydesign.com/"
    },
    "e8228b7b-52c3-49c8-a0ea-5b64b43a1051": {
      "studio": "Bouillon",
      "country": "Japan",
      "city": "Nagoya / Tokyo",
      "genre": "product-design",
