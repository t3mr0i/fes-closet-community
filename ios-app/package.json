{
  "name": "community.feswatch.app",
  "displayName": "FES Community",
  "version": "1.0.0",
  "description": "Community-built companion app for the Sony FES U Watch. Not affiliated with Sony.",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "ecosystem:cordova",
    "fes-closet",
    "sony-fes-watch"
  ],
  "author": "FES Closet Community",
  "license": "Apache-2.0",
  "devDependencies": {
    "cordova-ios": "^8.0.1",
    "cordova-plugin-battery-status": "^2.0.3",
    "cordova-plugin-bluetoothle": "^6.7.4",
    "cordova-plugin-camera": "^8.0.0",
    "cordova-plugin-cdp-nativebridge": "^1.1.0",
    "cordova-plugin-customurlscheme": "^5.0.2",
    "cordova-plugin-file": "^8.1.3",
    "cordova-plugin-inappbrowser": "^6.0.0",
    "cordova-plugin-insomnia": "^4.3.0",
    "cordova-plugin-vibration": "^3.1.1",
    "cordova-plugin-x-socialsharing": "^6.0.4",
    "es6-promise-plugin": "^4.2.2",
    "fes-nativebridge-stubs": "file:../fes-nativebridge-stubs",
    "nl-afas-cordova-plugin-securelocalstorage": "^0.1.18"
  },
  "cordova": {
    "platforms": [
      "ios"
    ],
    "plugins": {
